# Python virtual environment
backend/venv/
venv/
env_venv/
**/env_venv/
**/*venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Checkpoints, weights, binaries, and executables
**/ckpts/
**/finetunes/
**/ffmpeg_bins/
*.safetensors
*.onnx
*.ckpt
*.pth
*.bin
*.pt
*.exe
*.dll
*.lib
